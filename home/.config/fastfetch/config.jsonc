{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "separator": " \u001b[34m \u001b[0m",
    "color": {
      "keys": "cyan",
      "title": "blue"
    },
    "percent": {
      "type": 2
    }
  },
  "modules": [
    "title",
    "separator",

    {
      "type": "custom",
      "format": "\u001b[34m \u001b[31m \u001b[33m \u001b[32m\u001b[0m"
    },
    "break",

    {
      "type": "os",
      "key": "  󰣇 OS",
      "keyColor": "bright_blue"
    },
    {
      "type": "host",
      "key": "  󰌢 Host",
      "keyColor": "bright_blue"
    },
    {
      "type": "kernel",
      "key": "  󰒋 Kernel",
      "keyColor": "bright_blue"
    },
    {
      "type": "uptime",
      "key": "  󰔚 Uptime",
      "keyColor": "bright_blue"
    },
    {
      "type": "packages",
      "key": "  󰏖 Packages",
      "keyColor": "bright_blue"
    },
    
    "break",

    {
      "type": "wm",
      "key": "  󰨇 WM",
      "keyColor": "bright_magenta"
    },
    {
      "type": "display",
      "key": "  󰍹 Display",
      "keyColor": "bright_magenta"
    },
    {
      "type": "shell",
      "key": "  󰞷 Shell",
      "keyColor": "bright_magenta"
    },
    {
      "type": "terminal",
      "key": "  󰆍 Terminal",
      "keyColor": "bright_magenta"
    },
    {
      "type": "terminalfont",
      "key": "  󰛖 Font",
      "keyColor": "bright_magenta"
    },

    "break",

    {
      "type": "cpu",
      "key": "  󰻠 CPU",
      "keyColor": "bright_green"
    },
    {
      "type": "gpu",
      "key": "  󰢮 GPU",
      "keyColor": "bright_green"
    },
    {
      "type": "memory",
      "key": "  󰍛 Memory",
      "keyColor": "bright_green"
    },
    {
      "type": "disk",
      "key": "  󰋊 Disk",
      "keyColor": "bright_green",
      "folders": "/"
    },
    {
      "type": "battery",
      "key": "  󰁹 Battery",
      "keyColor": "bright_green"
    },

    "break",
    {
      "type": "localip",
      "key": "  󰩟 Local IP",
      "keyColor": "bright_cyan"
    }
  ]
}
