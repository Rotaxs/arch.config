{
    "bluetooth": {
        "format": "<span color='#a0a0a0'>󰂲</span> {num_connections}",
        "format-connected": "<span color='#b2cbe0'>󰂱</span> {num_connections}",
        "format-on": "<span color='#b2cbe0'>󰂯</span> {num_connections}",
        "tooltip-format": "Bluetooth Addr\t{controller_address}\n\n{controller_alias}\t{num_connections} connected",
        "on-click": "bash ~/.config/waybar/scripts/bluetooth.sh",
        "on-click-right": "alacritty -e bluetui"
    }
}
