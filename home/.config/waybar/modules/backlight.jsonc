{
    "backlight": {
        "format": "<span color='#d4c492'>{icon}</span> {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "on-scroll-up": "bash ~/.config/waybar/scripts/brightness.sh up",
        "on-scroll-down": "bash ~/.config/waybar/scripts/brightness.sh down",
        "min-brightness": 5,
        "tooltip-format": "Brightness  {percent}%\n\nScroll Up   +1%\nScroll Down -1%"
    }
}
