{
    "network": {
        "format-wifi": "<span color='#a8bfd2'>{icon}</span> {signalStrength}%",
        "format-ethernet": "<span color='#a8bfd2'>󰈀</span>",
        "format-disconnected": "<span color='#dc9696'>󰤮</span>",
        "tooltip-format": "{ifname}",
        "tooltip-format-wifi": "{essid}  {ipaddr}\n\nUp: {bandwidthUpBytes}\tDown: {bandwidthDownBytes}",
        "tooltip-format-ethernet": "{ifname} ",
        "tooltip-format-disconnected": "Disconnected",
        "format-icons": [ "󰤯", "󰤟", "󰤢", "󰤥", "󰤨" ],
        "on-click": "bash ~/.config/waybar/scripts/wifi.sh",
        "on-click-right": "alacritty -e nmtui"
    }
}
